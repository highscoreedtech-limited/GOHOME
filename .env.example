# Copy to .env.local for local development.

# Base URL of the Go backend (backend/). When set, the contact form POSTs to
# /api/contact and (later) the library/calendar can fetch from the API. When
# UNSET, the app uses local data and the contact form uses a mailto fallback,
# so the site works with or without the backend running.
#
# Local dev (with `cd backend && go run ./cmd/api`):
# NEXT_PUBLIC_API_URL=http://localhost:8080
